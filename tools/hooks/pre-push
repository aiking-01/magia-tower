#!/bin/sh
# Pushing publishes the game (Vercel deploys main of magia-tower-f), so the tests must pass first.
# Enable once per clone:  git config core.hooksPath tools/hooks
# Skip only when you really mean it:  git push --no-verify
cd "$(git rev-parse --show-toplevel)/tools" || exit 1
if [ ! -d node_modules ]; then
  npm install --no-audit --no-fund >/dev/null 2>&1 || { echo "pre-push: npm install failed"; exit 1; }
fi
npm test --silent
